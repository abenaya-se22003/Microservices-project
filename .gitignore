# ========================================
#  HotelHub Microservices — .gitignore
# ========================================

# ---------- Environment / Secrets ----------
# CRITICAL: Never commit .env files containing passwords, API keys, or secrets
.env
.env.local
.env.*.local
!.env.example

# ---------- Java / Maven ----------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timeline.xml

# ---------- IDE — IntelliJ IDEA ----------
.idea/
*.iws
*.iml
*.ipr
out/

# ---------- IDE — VS Code ----------
.vscode/

# ---------- IDE — Eclipse ----------
.project
.classpath
.settings/
.metadata/
bin/

# ---------- IDE — NetBeans ----------
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/

# ---------- Node / React ----------
node_modules/
dist/
.cache/
*.tsbuildinfo

# ---------- OS Files ----------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~

# ---------- Logs ----------
*.log
logs/
