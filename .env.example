# ======================================================================
#  HotelHub Microservices — Environment Variables (Template)
#  Copy this file to '.env' and fill in your actual credentials.
#  CRITICAL: Do NOT commit the '.env' file containing your secrets!
# ======================================================================

# PostgreSQL Credentials (shared by database and microservices)
DB_USERNAME=postgres
DB_PASSWORD=123456

# JWT Token Signing Key (Base64-encoded secret, minimum 256-bit / 32 bytes)
# Used by auth-service for JWT token authentication
JWT_SECRET=your_base64_encoded_secret_key_here

# RabbitMQ Credentials (shared by RabbitMQ and microservices)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password_here
