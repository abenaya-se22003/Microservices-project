# =============================================
#  HotelHub Backend — Environment Variables
# =============================================
#  Set these in your IntelliJ Run Configuration
#  or as system environment variables.
#
#  IntelliJ: Run → Edit Configurations → Environment variables
#  Terminal:  set DB_PASSWORD=your_password  (Windows)
#             export DB_PASSWORD=your_password (Mac/Linux)
# =============================================

# PostgreSQL credentials (shared by all services)
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# JWT signing key (Base64-encoded, min 256-bit / 32 bytes)
# Used only by auth-service
JWT_SECRET=your_base64_encoded_secret_key_here

# Optional: Override database URLs per service (defaults are set in each application.properties)
# DB_URL=jdbc:postgresql://localhost:5432/your_db_name
